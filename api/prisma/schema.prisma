generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  INVESTOR
  ADMIN
  COMPLIANCE
  FINANCE
}

enum UserStatus {
  ACTIVE
  LOCKED
  DELETED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DepositStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

enum NewsContentType {
  ARTICLE
  WAVE
}

enum NewsFeedbackType {
  NOT_INTERESTED
  HIDE_TOPIC
  REPORT
  HIDE_SOURCE
}

enum NewsCrawlStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum NewsEditorialStatus {
  NOT_REQUESTED
  PROCESSING
  READY
  FAILED
}

enum AgencyStatus {
  PENDING
  APPROVED
  REJECTED
  LOCKED
}

enum AgencyPackageStatus {
  ACTIVE
  EXHAUSTED
  CANCELLED
}

enum CommissionStatus {
  EARNED
  PAID
  CANCELLED
}

enum ReferralCommissionType {
  DIRECT
  BRANCH
}

enum AiConversationStatus {
  ACTIVE
  ARCHIVED
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AiMessageKind {
  CHAT
  IMAGE
  DOCUMENT
  TRANSLATION
}

enum AiMessageStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  RINGING
  ACCEPTED
  COMPLETED
  REJECTED
  CANCELLED
  MISSED
  FAILED
}

enum ConversationType {
  DIRECT
  GROUP
}

enum ConversationMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum ChatMessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

model User {
  id                           String                 @id @default(cuid())
  email                        String                 @unique
  passwordHash                 String
  fullName                     String
  nickname                     String?
  /// Bản bỏ dấu + chữ thường của `fullName`, phục vụ tìm kiếm không dấu.
  /// KHÔNG ghi từ code: trigger `user_search_sync` giữ nó đồng bộ ở mọi
  /// đường ghi (migration 202609270002_search_normalized).
  fullNameNormalized           String?
  /// Như trên, cho `nickname`.
  nicknameNormalized           String?
  referralCode                 String                 @unique @default(cuid())
  referredById                 String?
  phone                        String?
  phoneNormalized              String?                @unique
  address                      String?
  avatarFileId                 String?
  bankAccountName              String?
  bankAccountNumber            String?
  bankName                     String?
  language                     String                 @default("vi")
  suspiciousLoginAlerts        Boolean                @default(true)
  loginRateLimitEnabled        Boolean                @default(true)
  inAppNotifications           Boolean                @default(true)
  emailNotifications           Boolean                @default(true)
  failedLoginAttempts          Int                    @default(0)
  loginLockedUntil             DateTime?
  /// Lần cuối người này đóng socket chat cuối cùng — nguồn của "Hoạt động 5 phút trước".
  /// Ở Postgres chứ không ở Redis: nó đọc kèm sẵn trong truy vấn thành viên hội thoại
  /// nên không tốn roundtrip, và không bay mất khi Redis bị flush. Redis chỉ giữ đúng
  /// một việc — "ngay lúc này có socket nào đang mở không".
  lastSeenAt                   DateTime?
  role                         UserRole               @default(INVESTOR)
  status                       UserStatus             @default(ACTIVE)
  balanceVnd                   Decimal                @default(0) @db.Decimal(20, 0)
  agencyTitle                  String?
  totalPackagesPurchased       Int                    @default(0)
  emailVerifiedAt              DateTime?
  termsAcceptedAt              DateTime?
  kycVerifiedAt                DateTime?
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt
  refreshTokens                RefreshToken[]
  webLoginRequests             WebLoginRequest[]
  passwordResetTickets         PasswordResetTicket[]
  kycSubmissions               KycSubmission[]        @relation("KycOwner")
  reviewedKyc                  KycSubmission[]        @relation("KycReviewer")
  deposits                     Deposit[]              @relation("DepositOwner")
  reviewedDeposits             Deposit[]              @relation("DepositReviewer")
  withdrawals                  Withdrawal[]           @relation("WithdrawalOwner")
  reviewedWithdrawals          Withdrawal[]           @relation("WithdrawalReviewer")
  purchaseOrders               PurchaseOrder[]
  nftAssets                    NftAsset[]
  ledgerEntries                LedgerEntry[]
  files                        FileUpload[]
  auditLogs                    AuditLog[]             @relation("AuditActor")
  referredBy                   User?                  @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals                    User[]                 @relation("UserReferrals")
  claimedSystemReferralCode    SystemReferralCode?    @relation("SystemReferralClaim")
  createdSystemReferralCodes   SystemReferralCode[]   @relation("SystemReferralCreator")
  referralCommissions          ReferralCommission[]   @relation("ReferralBeneficiary")
  referralCommissionOrders     ReferralCommission[]   @relation("ReferralBuyer")
  updatedReferralSettings      ReferralSetting[]      @relation("ReferralSettingUpdater")
  updatedAgencyPackageSettings AgencyPackageSetting[] @relation("AgencyPackageSettingUpdater")
  agency                       Agency?                @relation("AgencyOwner")
  reviewedAgencies             Agency[]               @relation("AgencyReviewer")
  agencyCommissionPurchases    AgencyCommission[]     @relation("CommissionBuyer")
  issuedAgencyContracts        AgencyContract[]       @relation("ContractIssuer")
  aiConversations              AiConversation[]
  outgoingCalls                Call[]                 @relation("CallCaller")
  incomingCalls                Call[]                 @relation("CallCallee")
  sentFriendRequests           FriendRequest[]        @relation("FriendRequestSender")
  receivedFriendRequests       FriendRequest[]        @relation("FriendRequestRecipient")
  friendships                  Friendship[]           @relation("FriendshipOwner")
  friendOf                     Friendship[]           @relation("FriendshipTarget")
  followedNewsExperts          NewsExpertFollow[]
  newsInterests                NewsUserInterest[]
  likedNewsArticles            NewsArticleLike[]
  newsFeedback                 NewsArticleFeedback[]
  newsAiSummaryUnlocks         NewsAiSummaryUnlock[]
  chatMemberships              ConversationMember[]
  createdConversations         Conversation[]         @relation("ConversationCreator")
  sentChatMessages             ChatMessage[]
  savedChatMessages            SavedChatMessage[]
  hiddenChatMessages HiddenChatMessage[]
}

model FriendRequest {
  requesterId String
  recipientId String
  createdAt   DateTime @default(now())
  requester   User     @relation("FriendRequestSender", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient   User     @relation("FriendRequestRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@id([requesterId, recipientId])
  @@index([recipientId, createdAt])
  @@index([requesterId, createdAt])
}

model Friendship {
  userId       String
  friendUserId String
  /// Tên gợi nhớ do CHỦ hàng này đặt cho người kia. Một chiều: A đặt tên cho
  /// B không đụng gì tới hàng B→A. null = chưa đặt, app rơi về nickname.
  alias        String?
  /// Bản bỏ dấu + chữ thường của `alias` — xem `User.fullNameNormalized`.
  aliasNormalized String?
  /// Ảnh RIÊNG chủ hàng này gán cho người kia, song song với `alias`. Một
  /// chiều, và chỉ mình họ thấy. null = chưa gán, app rơi về ảnh hồ sơ của
  /// người kia rồi mới tới chữ cái đầu.
  avatarFileId String?
  /// Số điện thoại và email RIÊNG chủ hàng này ghi cho người kia — ô ghi chú
  /// cá nhân, không ràng buộc định dạng. null = chưa ghi, app rơi về thông
  /// tin trong hồ sơ của người kia.
  aliasPhone   String?
  aliasEmail   String?
  createdAt    DateTime @default(now())
  user         User     @relation("FriendshipOwner", fields: [userId], references: [id], onDelete: Cascade)
  friend       User     @relation("FriendshipTarget", fields: [friendUserId], references: [id], onDelete: Cascade)

  @@id([userId, friendUserId])
  @@index([friendUserId])
  @@index([userId, createdAt])
}

model Conversation {
  id            String               @id @default(cuid())
  type          ConversationType
  directKey     String?              @unique
  title         String?
  /// Bản bỏ dấu + chữ thường của `title` — xem `User.fullNameNormalized`.
  titleNormalized String?
  avatarFileId  String?
  createdById   String
  lastMessageAt DateTime             @default(now())
  deletedAt     DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  createdBy     User                 @relation("ConversationCreator", fields: [createdById], references: [id])
  members       ConversationMember[]
  messages      ChatMessage[]

  @@index([lastMessageAt])
  @@index([createdById, createdAt])
}

model ConversationMember {
  conversationId    String
  userId            String
  role              ConversationMemberRole @default(MEMBER)
  isMuted           Boolean                @default(false)
  isHidden          Boolean                @default(false)
  lastReadMessageId String?
  lastReadAt        DateTime?
  joinedAt          DateTime               @default(now())
  leftAt            DateTime?
  conversation      Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, isHidden, leftAt])
}

model ChatMessage {
  id                    String             @id @default(cuid())
  conversationId        String
  senderId              String?
  type                  ChatMessageType    @default(TEXT)
  content               String?
  attachments           Json?
  clientMessageId       String?
  replyToId             String?
  quotedMessageSnapshot Json?
  /// Ảnh chụp thẻ og: của link đầu tiên trong tin, lấy lúc GỬI.
  /// Giữ nguyên kể cả khi trang đổi nội dung sau đó — xem migration
  /// 202609270006_message_link_preview.
  linkPreview           Json?
  /// Số liệu cuộc gọi của một tin hệ thống loại "nhật ký cuộc gọi":
  /// `{ call_id, call_type, status, duration_sec }`. Xem migration
  /// 202609270007_message_call_info.
  callInfo              Json?
  editedAt              DateTime?
  deletedAt             DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  conversation          Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender                User?              @relation(fields: [senderId], references: [id], onDelete: SetNull)
  replyTo               ChatMessage?       @relation("ChatMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies               ChatMessage[]      @relation("ChatMessageReplies")
  savedBy               SavedChatMessage[]

  @@unique([conversationId, clientMessageId])
  @@index([conversationId, createdAt, id])
  @@index([senderId, createdAt])
  @@index([replyToId])
  hiddenBy      HiddenChatMessage[]
}

model SavedChatMessage {
  userId    String
  messageId String
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([userId, messageId])
  @@index([userId, createdAt])
}

/// Tin bị ẩn ở phía MỘT người.
///
/// Khác `ChatMessage.deletedAt` (thu hồi, ai cũng mất): hàng này chỉ nói
/// "người `userId` không muốn thấy tin `messageId` nữa". Người gửi và mọi
/// thành viên khác vẫn thấy nguyên.
model HiddenChatMessage {
  userId    String
  messageId String
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([userId, messageId])
  @@index([userId, createdAt])
}

model Call {
  id             String     @id @default(uuid())
  channelName    String     @unique
  conversationId String?
  callerId       String
  calleeId       String
  callType       CallType
  status         CallStatus @default(RINGING)
  endReason      String?
  ringingAt      DateTime   @default(now())
  /// Máy người nhận báo đã thấy cuộc gọi (POST /calls/:id/ringing) — người gọi
  /// đổi "Đang gọi…" thành "Đang đổ chuông…"
  deliveredAt    DateTime?
  acceptedAt     DateTime?
  endedAt        DateTime?
  durationSec    Int        @default(0)
  callerClient   String?
  calleeClient   String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  caller         User       @relation("CallCaller", fields: [callerId], references: [id])
  callee         User       @relation("CallCallee", fields: [calleeId], references: [id])

  @@index([callerId, status])
  @@index([calleeId, status])
  @@index([createdAt])
  @@index([conversationId, createdAt])
}

model RefreshToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  deviceInfo String?
  deviceType String?
  location   String?
  fcmToken   String?
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
}

model PasswordResetTicket {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model VerificationCode {
  id         String    @id @default(cuid())
  email      String
  purpose    String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([email, purpose, createdAt])
}

model KycSubmission {
  id                String       @id @default(cuid())
  userId            String
  fullName          String
  dateOfBirth       DateTime?
  idCardNumber      String?
  phoneNumber       String
  address           String
  bankAccountName   String?
  bankAccountNumber String?
  bankName          String?
  idFrontFileUrl    String
  idBackFileUrl     String
  selfieFileUrl     String?
  status            ReviewStatus @default(PENDING)
  rejectionReason   String?
  reviewNote        String?
  reviewedById      String?
  reviewedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  user              User         @relation("KycOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy        User?        @relation("KycReviewer", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
}

model Deposit {
  id                  String        @id @default(cuid())
  userId              String
  amountVnd           Decimal       @db.Decimal(20, 0)
  transferCode        String        @unique
  proofFileUrl        String?
  idempotencyKey      String        @unique
  status              DepositStatus @default(PENDING)
  reviewedById        String?
  reviewedAt          DateTime?
  reviewNote          String?
  vietQrOrderId       String?       @unique
  qrCodeUrl           String?
  vietQrData          Json?
  bankTransactionId   String?       @unique
  bankReferenceNumber String?
  paidAmountVnd       Decimal?      @db.Decimal(20, 0)
  paidAt              DateTime?
  balanceBeforeVnd    Decimal?      @db.Decimal(20, 0)
  balanceAfterVnd     Decimal?      @db.Decimal(20, 0)
  expiresAt           DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  user                User          @relation("DepositOwner", fields: [userId], references: [id])
  reviewedBy          User?         @relation("DepositReviewer", fields: [reviewedById], references: [id])
  ledgerEntry         LedgerEntry?

  @@index([status, createdAt])
  @@index([status, expiresAt])
  @@index([userId, createdAt])
}

model Withdrawal {
  id                    String           @id @default(cuid())
  userId                String
  amountVnd             Decimal          @db.Decimal(20, 0)
  bankName              String
  bankAccountNumber     String
  bankAccountName       String
  status                WithdrawalStatus @default(PENDING)
  idempotencyKey        String
  balanceBeforeVnd      Decimal          @db.Decimal(20, 0)
  balanceAfterVnd       Decimal          @db.Decimal(20, 0)
  reviewedById          String?
  reviewedAt            DateTime?
  reviewNote            String?
  rejectionReason       String?
  transferProofFileId   String?
  bankTransactionCode   String?          @unique
  refundedAt            DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  user                  User             @relation("WithdrawalOwner", fields: [userId], references: [id])
  reviewedBy            User?            @relation("WithdrawalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  ledgerEntries         LedgerEntry[]

  @@unique([userId, idempotencyKey])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model FileUpload {
  id           String   @id @default(cuid())
  ownerId      String
  originalName String
  storedName   String   @unique
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
}

model NftProduct {
  id              String                  @id @default(cuid())
  name            String
  symbol          String
  description     String
  imageUrl        String
  metadataBaseUrl String
  unitPriceVnd    Decimal                 @db.Decimal(20, 0)
  totalSupply     Int
  soldCount       Int                     @default(0)
  isActive        Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  purchaseOrders  PurchaseOrder[]
  nftAssets       NftAsset[]
  agencyPackages  AgencyPackagePurchase[]
}

model PurchaseOrder {
  id                    String               @id @default(cuid())
  userId                String
  productId             String
  quantity              Int
  unitPriceVnd          Decimal              @db.Decimal(20, 0)
  totalVnd              Decimal              @db.Decimal(20, 0)
  grossTotalVnd         Decimal?             @db.Decimal(20, 0)
  discountVnd           Decimal?             @db.Decimal(20, 0)
  effectiveDiscountRate Decimal?             @db.Decimal(5, 4)
  agencyTitle           String?
  unitPriceUsd          Decimal?             @db.Decimal(10, 2)
  usdVndRate            Decimal?             @db.Decimal(20, 4)
  pricingBreakdown      Json?
  referralCode          String?
  idempotencyKey        String               @unique
  status                OrderStatus          @default(PENDING)
  agencyId              String?
  commissionRate        Decimal?             @db.Decimal(5, 4)
  commissionVnd         Decimal?             @db.Decimal(20, 0)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  user                  User                 @relation(fields: [userId], references: [id])
  product               NftProduct           @relation(fields: [productId], references: [id])
  ledgerEntry           LedgerEntry?
  nftAssets             NftAsset[]
  agency                Agency?              @relation(fields: [agencyId], references: [id])
  agencyCommission      AgencyCommission?
  referralCommissions   ReferralCommission[]

  @@index([status, createdAt])
}

model NftAsset {
  id          String        @id @default(cuid())
  assetCode   String        @unique
  metadataUrl String
  ownerId     String
  productId   String
  orderId     String
  issuedAt    DateTime      @default(now())
  owner       User          @relation(fields: [ownerId], references: [id])
  product     NftProduct    @relation(fields: [productId], references: [id])
  order       PurchaseOrder @relation(fields: [orderId], references: [id])

  @@index([ownerId, issuedAt])
}

model LedgerEntry {
  id                   String              @id @default(cuid())
  userId               String
  amountVnd            Decimal             @db.Decimal(20, 0)
  direction            LedgerDirection
  description          String
  depositId            String?             @unique
  orderId              String?             @unique
  commissionId         String?             @unique
  referralCommissionId String?             @unique
  withdrawalId         String?
  createdAt            DateTime            @default(now())
  user                 User                @relation(fields: [userId], references: [id])
  deposit              Deposit?            @relation(fields: [depositId], references: [id])
  order                PurchaseOrder?      @relation(fields: [orderId], references: [id])
  commission           AgencyCommission?   @relation(fields: [commissionId], references: [id])
  referralCommission   ReferralCommission? @relation(fields: [referralCommissionId], references: [id])
  withdrawal           Withdrawal?         @relation(fields: [withdrawalId], references: [id])

  @@index([userId, createdAt])
  @@index([withdrawalId, createdAt])
}

model ReferralSetting {
  id          String   @id
  directRate  Decimal  @default(0.10) @db.Decimal(5, 4)
  branchRate  Decimal  @default(0.05) @db.Decimal(5, 4)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedBy   User?    @relation("ReferralSettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
}

model SystemReferralCode {
  id          String    @id @default(cuid())
  code        String    @unique
  label       String?
  isActive    Boolean   @default(true)
  createdById String
  claimedById String?   @unique
  claimedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   User      @relation("SystemReferralCreator", fields: [createdById], references: [id])
  claimedBy   User?     @relation("SystemReferralClaim", fields: [claimedById], references: [id], onDelete: SetNull)

  @@index([isActive, createdAt])
}

model ReferralCommission {
  id            String                 @id @default(cuid())
  orderId       String
  beneficiaryId String
  buyerId       String
  type          ReferralCommissionType
  rate          Decimal                @db.Decimal(5, 4)
  amountVnd     Decimal                @db.Decimal(20, 0)
  status        CommissionStatus       @default(EARNED)
  createdAt     DateTime               @default(now())
  paidAt        DateTime?
  order         PurchaseOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  beneficiary   User                   @relation("ReferralBeneficiary", fields: [beneficiaryId], references: [id])
  buyer         User                   @relation("ReferralBuyer", fields: [buyerId], references: [id])
  ledgerEntry   LedgerEntry?

  @@unique([orderId, beneficiaryId, type])
  @@index([beneficiaryId, type, createdAt])
  @@index([buyerId, createdAt])
}

model Agency {
  id                     String                  @id @default(cuid())
  userId                 String                  @unique
  code                   String                  @unique
  businessName           String
  taxCode                String?
  phone                  String
  address                String
  status                 AgencyStatus            @default(PENDING)
  parentId               String?
  reviewNote             String?
  rejectionReason        String?
  reviewedById           String?
  reviewedAt             DateTime?
  approvedAt             DateTime?
  lockedAt               DateTime?
  totalRevenueVnd        Decimal                 @default(0) @db.Decimal(20, 0)
  totalCommissionVnd     Decimal                 @default(0) @db.Decimal(20, 0)
  title                  String?
  totalPackagesPurchased Int                     @default(0)
  discountRate           Decimal                 @default(0) @db.Decimal(5, 4)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  user                   User                    @relation("AgencyOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy             User?                   @relation("AgencyReviewer", fields: [reviewedById], references: [id])
  parent                 Agency?                 @relation("AgencyTree", fields: [parentId], references: [id], onDelete: SetNull)
  children               Agency[]                @relation("AgencyTree")
  store                  AgencyStore?
  packages               AgencyPackagePurchase[]
  commissions            AgencyCommission[]
  purchaseOrders         PurchaseOrder[]
  contract               AgencyContract?

  @@index([status, createdAt])
  @@index([parentId])
}

model AgencyStore {
  id           String   @id @default(cuid())
  agencyId     String   @unique
  slug         String   @unique
  name         String
  description  String?
  logoUrl      String?
  bannerUrl    String?
  contactEmail String?
  contactPhone String?
  primaryColor String   @default("#174EA6")
  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  agency       Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
}

model AgencyPackagePurchase {
  id                       String              @id @default(cuid())
  agencyId                 String
  productId                String
  tier                     String
  quantity                 Int
  discountRate             Decimal             @db.Decimal(5, 4)
  grossAmountVnd           Decimal             @db.Decimal(20, 0)
  netAmountVnd             Decimal             @db.Decimal(20, 0)
  unitPriceUsd             Decimal             @default(25) @db.Decimal(10, 2)
  usdVndRate               Decimal             @default(25000) @db.Decimal(20, 4)
  unitPriceVnd             Decimal             @default(625000) @db.Decimal(20, 0)
  startingPackageNumber    Int                 @default(1)
  endingPackageNumber      Int                 @default(1)
  effectiveDiscountRate    Decimal             @default(0) @db.Decimal(5, 4)
  pricingBreakdown         Json?
  commissionSlots          Int
  remainingCommissionSlots Int
  status                   AgencyPackageStatus @default(ACTIVE)
  createdAt                DateTime            @default(now())
  agency                   Agency              @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  product                  NftProduct          @relation(fields: [productId], references: [id])

  @@index([agencyId, status, createdAt])
  @@index([productId])
}

model AgencyPackageSetting {
  id           String   @id
  basePriceUsd Decimal  @default(25) @db.Decimal(10, 2)
  usdVndRate   Decimal  @default(25000) @db.Decimal(20, 4)
  updatedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  updatedBy    User?    @relation("AgencyPackageSettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}

model AgencyCommission {
  id          String           @id @default(cuid())
  agencyId    String
  orderId     String           @unique
  buyerId     String
  amountVnd   Decimal          @db.Decimal(20, 0)
  rate        Decimal          @db.Decimal(5, 4)
  status      CommissionStatus @default(EARNED)
  createdAt   DateTime         @default(now())
  paidAt      DateTime?
  agency      Agency           @relation(fields: [agencyId], references: [id])
  order       PurchaseOrder    @relation(fields: [orderId], references: [id])
  buyer       User             @relation("CommissionBuyer", fields: [buyerId], references: [id])
  ledgerEntry LedgerEntry?

  @@index([agencyId, createdAt])
}

model AgencyContract {
  id             String   @id @default(cuid())
  agencyId       String   @unique
  contractNumber String   @unique
  issuedById     String
  snapshot       Json
  issuedAt       DateTime @default(now())
  agency         Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  issuedBy       User     @relation("ContractIssuer", fields: [issuedById], references: [id])
}

model AiExpert {
  id            String           @id @default(cuid())
  name          String
  slug          String           @unique
  specialty     String
  description   String
  avatarUrl     String?
  systemPrompt  String
  capabilities  Json
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  conversations AiConversation[]
}

model AiConversation {
  id        String               @id @default(cuid())
  userId    String
  expertId  String
  title     String
  status    AiConversationStatus @default(ACTIVE)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  expert    AiExpert             @relation(fields: [expertId], references: [id])
  messages  AiMessage[]

  @@index([userId, updatedAt])
}

model AiMessage {
  id             String          @id @default(cuid())
  conversationId String
  role           AiMessageRole
  kind           AiMessageKind   @default(CHAT)
  status         AiMessageStatus @default(COMPLETED)
  content        String
  attachmentUrl  String?
  metadata       Json?
  errorMessage   String?
  createdAt      DateTime        @default(now())
  completedAt    DateTime?
  conversation   AiConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model NewsArticle {
  id                      String                @id @default(cuid())
  title                   String
  slug                    String                @unique
  summary                 String
  aiSummary               String?
  content                 String
  imageUrl                String?
  videoUrl                String?
  sourceUrl               String?
  contentType             NewsContentType       @default(ARTICLE)
  status                  ArticleStatus         @default(DRAFT)
  topicId                 String?
  expertId                String?
  sourceId                String?
  externalKey             String?
  sourceTitle             String?
  sourceAuthor            String?
  sourceContent           String?
  sourcePublishedAt       DateTime?
  sourceFetchedAt         DateTime?
  aiEditorialStatus       NewsEditorialStatus   @default(NOT_REQUESTED)
  aiEditorialError        String?
  aiEditorialModel        String?
  aiEditorialInputTokens  Int?
  aiEditorialOutputTokens Int?
  aiEditorialTotalTokens  Int?
  aiEditorialAt           DateTime?
  publishedAt             DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  topic                   NewsTopic?            @relation(fields: [topicId], references: [id], onDelete: SetNull)
  expert                  NewsExpert?           @relation(fields: [expertId], references: [id], onDelete: SetNull)
  source                  NewsSource?           @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  likes                   NewsArticleLike[]
  feedback                NewsArticleFeedback[]
  aiSummaryUnlocks        NewsAiSummaryUnlock[]

  @@unique([sourceId, externalKey])
  @@index([status, publishedAt])
  @@index([topicId, status, publishedAt])
  @@index([expertId, status, publishedAt])
  @@index([contentType, status, publishedAt])
  @@index([sourceId, sourcePublishedAt])
  @@index([aiEditorialStatus, createdAt])
}

model NewsSource {
  id                   String         @id
  key                  String         @unique
  name                 String
  baseUrl              String
  listingUrl           String
  isActive             Boolean        @default(true)
  crawlIntervalMinutes Int            @default(120)
  maxItemsPerRun       Int            @default(8)
  topicId              String?
  lastCrawledAt        DateTime?
  lastSuccessAt        DateTime?
  lastError            String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  topic                NewsTopic?     @relation(fields: [topicId], references: [id], onDelete: SetNull)
  articles             NewsArticle[]
  crawlRuns            NewsCrawlRun[]
  feedback             NewsArticleFeedback[]

  @@index([isActive, lastCrawledAt])
  @@index([topicId])
}

model NewsCrawlRun {
  id           String          @id @default(cuid())
  sourceId     String
  status       NewsCrawlStatus @default(RUNNING)
  discovered   Int             @default(0)
  imported     Int             @default(0)
  skipped      Int             @default(0)
  failed       Int             @default(0)
  errorMessage String?
  startedAt    DateTime        @default(now())
  completedAt  DateTime?
  source       NewsSource      @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, startedAt])
  @@index([status, startedAt])
}

model NewsTopic {
  id        String                @id @default(cuid())
  name      String
  slug      String                @unique
  isActive  Boolean               @default(true)
  sortOrder Int                   @default(0)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  articles  NewsArticle[]
  interests NewsUserInterest[]
  feedback  NewsArticleFeedback[]
  sources   NewsSource[]

  @@index([isActive, sortOrder])
}

model NewsExpert {
  id         String             @id @default(cuid())
  name       String
  slug       String             @unique
  specialty  String
  bio        String
  avatarUrl  String?
  coverUrl   String?
  initials   String
  isVerified Boolean            @default(false)
  isActive   Boolean            @default(true)
  sortOrder  Int                @default(0)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  articles   NewsArticle[]
  followers  NewsExpertFollow[]

  @@index([isActive, sortOrder])
}

model NewsExpertFollow {
  userId    String
  expertId  String
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  expert    NewsExpert @relation(fields: [expertId], references: [id], onDelete: Cascade)

  @@id([userId, expertId])
  @@index([expertId, createdAt])
}

model NewsUserInterest {
  userId    String
  topicId   String
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic     NewsTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([userId, topicId])
  @@index([topicId])
}

model NewsArticleLike {
  userId    String
  articleId String
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
  @@index([articleId, createdAt])
}

model NewsArticleFeedback {
  id        String           @id @default(cuid())
  userId    String
  articleId String
  /// Chỉ có ở `HIDE_TOPIC`: lĩnh vực bị ẩn, chép từ bài lúc bấm.
  topicId   String?
  /// Chỉ có ở `HIDE_SOURCE`: nguồn bị ẩn, chép từ bài lúc bấm — để bộ lọc
  /// tin đọc thẳng từ đây trong một truy vấn, không phải join qua bài.
  sourceId  String?
  type      NewsFeedbackType
  reason    String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   NewsArticle      @relation(fields: [articleId], references: [id], onDelete: Cascade)
  topic     NewsTopic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)
  source    NewsSource?      @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([userId, articleId, type])
  @@index([articleId, type])
  @@index([userId, type, createdAt])
  @@index([sourceId])
}

/// Một dòng = một người đã mở bản tóm tắt AI của một bài = một lượt đã dùng.
/// Khoá chính (userId, articleId) bảo đảm mở lại bài cũ không bị trừ lượt
/// lần hai; số lượt trong tháng là số dòng có `createdAt` trong tháng đó.
model NewsAiSummaryUnlock {
  userId    String
  articleId String
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
  @@index([userId, createdAt])
  @@index([articleId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entityType, entityId, createdAt])
}

enum WebLoginStatus {
  PENDING
  SCANNED
  APPROVED
  REJECTED
  CONSUMED
}

/// Yêu cầu đăng nhập web bằng mã QR — xem docs/web-qr-login-design.md.
/// Chỉ `id` nằm trong QR; khoá bí mật chỉ lưu dạng băm.
model WebLoginRequest {
  id         String         @id
  secretHash String
  status     WebLoginStatus @default(PENDING)
  userId     String?
  browser    String?
  ipAddress  String?
  expiresAt  DateTime
  createdAt  DateTime       @default(now())
  scannedAt  DateTime?
  decidedAt  DateTime?
  user       User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

POSTGRES_DB=mindo
POSTGRES_USER=mindo
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://mindo:replace-with-a-long-random-password@postgres:5432/mindo?schema=public
NEWS_CRAWL_ENABLED=true

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-before-first-deploy
APP_URL=https://api-mindo.stg-studio.com
CORS_ORIGINS=https://admin-mindo.stg-studio.com

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Mindo <no-reply@example.com>"

FILE_URL_SIGNING_SECRET=replace-with-a-separate-32-character-secret
FILE_URL_TTL_SECONDS=900

VIETQR_MODE=quicklink
VIETQR_BANK_CODE=VCB
VIETQR_BANK_NAME=Vietcombank
VIETQR_BANK_ACCOUNT=
VIETQR_ACCOUNT_NAME=MINDO
VIETQR_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
VIETQR_CALLBACK_USERNAME=
VIETQR_CALLBACK_PASSWORD=
VIETQR_CALLBACK_JWT_SECRET=replace-with-a-separate-32-character-jwt-secret

AI_MOCK=true
LLM_PRIMARY_VENDOR=gemini
LLM_FALLBACK_VENDOR=deepseek
GEMINI_API_KEY=
GEMINI_NATIVE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
DEEPSEEK_API_KEY=
